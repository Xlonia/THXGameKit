; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="THXGameKit"
config/description="弹幕专题游戏制作内核（次级引擎）——弹幕运行时/事件/时间轴/角色数据基底/弹幕编辑器"
run/main_scene="res://scenes/title_menu.tscn"
config/features=PackedStringArray("4.7")
run/max_fps=60

[autoload]

THXKit="*res://addons/thx_gamekit/core/kit.gd"
GameGlobals="*res://addons/thx_gamekit/editor/game_globals_compat.gd"

[display]

display/window/subwindows/embed_subwindows=false
display/window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/thx_gamekit/plugin.cfg")

[rendering]

renderer/rendering_method.mobile="gl_compatibility"
; 【渲染后端20261114】作者卡死数据定性：Vulkan同步风暴（Optimus双GPU每帧GPU同步400ms；2D内核不需要Vulkan特性）
; 切Compatibility（OpenGL3）——弹幕/编辑器全部2D，GL完全够用且驱动兼容性好
renderer/rendering_method="gl_compatibility"
