; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="THXGameKit"
config/description="弹幕专题游戏制作内核（次级引擎）——弹幕运行时/事件/时间轴/角色数据基底/弹幕编辑器"
run/main_scene="res://scenes/title_menu.tscn"
config/features=PackedStringArray("4.7")
run/max_fps=60

[autoload]

THXKit="*res://addons/thx_gamekit/core/kit.gd"
GameGlobals="*res://addons/thx_gamekit/editor/game_globals_compat.gd"

[rendering]

## 【渲染后端 20261114（作者卡死数据定性：Vulkan 同步风暴——Optimus 双 GPU
## 每帧 GPU 同步 400ms；2D 内核不需要 Vulkan 特性）】
## 切 Compatibility（OpenGL3）——弹幕/编辑器全部 2D，GL 完全够用且驱动兼容性好
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[display]

; vsync 禁用+max_fps=60 节流（20261114：vsync 等待异常=每帧 140ms 缓冲交换阻塞——max_fps 精确节流替代）
display/window/vsync/vsync_mode=0
; low_processor_usage_mode 已移除（20261114：静置降帧到 5fps=作者卡死观感直接来源）

[editor_plugins]

enabled=PackedStringArray("res://addons/thx_gamekit/plugin.cfg")
