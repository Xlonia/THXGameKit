; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="THXGameKit"
config/description="弹幕专题游戏制作内核（次级引擎）——弹幕运行时/事件/时间轴/角色数据基底/弹幕编辑器"
run/main_scene="res://scenes/danmaku_editor.tscn"
config/features=PackedStringArray("4.7")

[autoload]

THXKit="*res://addons/thx_gamekit/core/kit.gd"
GameGlobals="*res://addons/thx_gamekit/editor/game_globals_compat.gd"

[editor_plugins]

enabled=PackedStringArray("addons/thx_gamekit/plugin.cfg")
