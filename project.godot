; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="THXGameKit"
config/description="弹幕专题游戏制作内核（次级引擎）——弹幕运行时/事件/时间轴/角色数据基底/弹幕编辑器"
run/main_scene="res://scenes/title_menu.tscn"
config/features=PackedStringArray("4.7")
run/max_fps=60

[autoload]

THXKit="*res://addons/thx_gamekit/core/kit.gd"
GameGlobals="*res://addons/keshinozo/game_globals.gd" ## 【m125 插件化】兼容层退役→插件真全局（字段面四函数全兼容+官方CSV缺文件容错已有——作者批复②=kit编辑器自带玩法）

[display]

display/window/subwindows/embed_subwindows=false
display/window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/thx_gamekit/plugin.cfg", "res://addons/keshinozo/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
