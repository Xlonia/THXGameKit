; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="THXGameKit"
config/description="弹幕专题游戏制作内核（次级引擎）——弹幕运行时/事件/时间轴/角色数据基底/弹幕编辑器"
run/main_scene="res://scenes/title_menu.tscn"
config/features=PackedStringArray("4.7")

[autoload]

THXKit="*res://addons/thx_gamekit/core/kit.gd"
GameGlobals="*res://addons/thx_gamekit/editor/game_globals_compat.gd"

[display]

## 【窗口化 20261114（作者方向）】编辑器/试炼场=独立 OS 窗口（标题主窗常驻）——
## 退出=关窗，绕开 change_scene 全链
[window]
subwindows/embed_subwindows=false

[editor_plugins]

enabled=PackedStringArray("addons/thx_gamekit/plugin.cfg")
